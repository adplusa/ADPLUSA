# Server Configuration
PORT=4000
NODE_ENV=development

# Gmail for sending emails
GMAIL_USER=your-gmail-account@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Database
MONGODB_URI=mongodb://localhost:27017/architect-cms

# JWT Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# AWS S3 Image Storage (keys only needed for local dev; Lambda uses IAM role)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=architect-cms-images
APP_AWS_REGION=us-east-1
AWS_CLOUDFRONT_URL=

# Redis — use REDIS_URL for Upstash/managed Redis, or individual vars for local
REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379
# Fallback individual config (used if REDIS_URL is not set)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Sanity (for migration only)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# CORS
CORS_ORIGIN=http://localhost:3000
